@startuml EventStreamAnalyzer
' This diagram follows the implemented classes and their responsibilities.
' Strategy separates parsing, aggregation, and output.
' Simple Factory keeps classification and record creation in one place.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
hide empty members

title Event Stream Analyzer: Class Diagram (Strategy + Simple Factory)

' ======================= ENTRY / PIPELINE =======================
class Main {
  + {static} main(args : String[]) : void
}

class ArgParser {
  + parse(args : String[]) : CliOptions
}

class CliOptions {
  - inputFile : Path
  - outputDir : Path
  + inputFile() : Path
  + outputDir() : Path
}

class AnalyzerPipeline {
  - parser : LineParser
  - factory : RecordFactory
  - outputs : Map<String,Aggregator>
  - aggregatorsByType : Map<RecordType,Aggregator>
  - writer : OutputWriter
  + run(input : Path, outDir : Path) : void
}

' ======================= INPUT (Strategy) =======================
interface LineParser <<Strategy>> {
  + parse(line : String) : Map<String,String>
}
class KeyValueParser {
  + parse(line : String) : Map<String,String>
}
note bottom of KeyValueParser
  Parses key=value fields and
  quoted values with spaces.
  A JSON Lines parser can implement
  LineParser without changing this class.
  (NFR-2)
end note

' ======================= MODEL =======================
interface Record {
  + type() : RecordType
}
enum RecordType {
  SENSOR
  DEVICE
  ACCESS
}
enum Severity {
  CRITICAL
  ERROR
  WARN
  INFO
  --
  ' declared high -> low;
  ' natural order drives
  ' tie-break (FR-14)
}
class SensorReading <<record>> {
  + sensor : String
  + reading : double
}
class DeviceEvent <<record>> {
  + device : String
  + severity : Severity
}
class AccessRecord <<record>> {
  + user : String
  + door : String
  + granted : boolean
  + durationMs : int
}

' ======================= CLASSIFICATION (Factory) =======================
class RecordFactory <<Simple Factory>> {
  + classify(fields : Map<String,String>) : Optional<Record>
}
note right of RecordFactory
  Validates fields and creates records.
  Invalid or unmatched fields return
  Optional.empty() so processing continues.
  A new type adds a classifier here,
  an enum value, and wiring in Main. (FR-7)
end note

' ======================= AGGREGATION (Strategy) =======================
interface Aggregator <<Strategy>> {
  + handles() : RecordType
  + accept(r : Record) : void
  + result() : Map<String,Object>
}
class SensorAggregator {
  - readingsBySensor : Map<String,List<Double>>
  + accept(r : Record) : void
  + result() : Map<String,Object>
}
class DeviceAggregator {
  - countsBySeverity : Map<Severity,Integer>
  - severityCountsByDevice : Map<String,Map<Severity,Integer>>
  + accept(r : Record) : void
  + result() : Map<String,Object>
}
class AccessAggregator {
  - statsByDoor : Map<String,DoorStats>
  + accept(r : Record) : void
  + result() : Map<String,Object>
}
class Stats <<utility>> {
  + {static} mean(xs : List<Double>) : double
  + {static} median(xs : List<Double>) : double
  + {static} populationStdDev(xs : List<Double>) : double
  + {static} nearestRankPercentile(sorted : List<Integer>, p : int) : int
}
note bottom of Stats
  Median and nearest-rank percentiles
  use separate methods. For even counts,
  their results can differ by design.
  (FR-18)
end note

' ======================= OUTPUT (Strategy) =======================
interface OutputWriter <<Strategy>> {
  + write(fileBase : String, data : Map<String,Object>, outDir : Path) : void
}
class JsonWriter {
  - gson : Gson
  + write(fileBase : String, data : Map<String,Object>, outDir : Path) : void
}
note bottom of JsonWriter
  Writes JSON with two-space indentation.
  Rounds decimals to one place and removes
  decimal points from whole results.
  Empty reports contain {}. (FR-20/21)
  A CSV writer can implement OutputWriter.
  (NFR-3)
end note

' ======================= RELATIONSHIPS =======================
Main --> ArgParser
ArgParser --> CliOptions
Main --> AnalyzerPipeline
Main ..> CliOptions

AnalyzerPipeline --> LineParser
AnalyzerPipeline --> RecordFactory
AnalyzerPipeline "1" o--> "0..*" Aggregator
AnalyzerPipeline --> OutputWriter

LineParser <|.. KeyValueParser

Record <|.. SensorReading
Record <|.. DeviceEvent
Record <|.. AccessRecord
Record --> RecordType
DeviceEvent --> Severity

RecordFactory ..> Record : creates
RecordFactory ..> RecordType

Aggregator <|.. SensorAggregator
Aggregator <|.. DeviceAggregator
Aggregator <|.. AccessAggregator
SensorAggregator ..> Stats
DeviceAggregator ..> Severity
AccessAggregator ..> Stats

OutputWriter <|.. JsonWriter
AnalyzerPipeline ..> OutputWriter : "writes result() per aggregator"

@enduml
